<Window x:Class="StreamHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="StreamHub" Height="840" Width="1380" MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Background="#090B10" FontFamily="Segoe UI Variable Display,Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#151922"/>
        <SolidColorBrush x:Key="Muted" Color="#8F98AA"/>
        <SolidColorBrush x:Key="Accent" Color="#5CE1C0"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#222733"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#313744"/><Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#303746"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#4A5364"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#151922"/>
            <Setter Property="BorderBrush" Value="#2B3140"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/><Setter Property="Padding" Value="12,9"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/><Setter Property="Background" Value="#22262E"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background><RadialGradientBrush Center="0.82,0.05" GradientOrigin="0.82,0.05" RadiusX="0.85" RadiusY="0.8"><GradientStop Color="#182233" Offset="0"/><GradientStop Color="#090B10" Offset="0.68"/></RadialGradientBrush></Grid.Background>
        <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#D90D1016" BorderBrush="#242A36" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,27">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,34">
                        <Border Width="38" Height="38" CornerRadius="11"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#74F1CF"/><GradientStop Color="#36ADEF" Offset="1"/></LinearGradientBrush></Border.Background>
                            <TextBlock Text="S" FontSize="22" FontWeight="Bold" Foreground="#081016" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,1,0,0"><TextBlock Text="STREAMHUB" Foreground="White" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="All your streaming" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"/></StackPanel>
                    </StackPanel>
                    <TextBlock Text="MENU" Foreground="#657084" FontSize="10" FontWeight="SemiBold" Margin="10,0,0,10"/>
                    <Button Content="⌂    Home" HorizontalContentAlignment="Left" Click="ShowHome_Click" Margin="0,0,0,7" Background="#26303B" BorderBrush="#3E4A58"/>
                    <Button Content="▦    Services" HorizontalContentAlignment="Left" Click="ShowServices_Click" Margin="0,0,0,7" Background="Transparent" BorderBrush="Transparent"/>
                    <Button Content="▶    Live TV" HorizontalContentAlignment="Left" Click="ShowLiveTv_Click" Margin="0,0,0,7" Background="Transparent" BorderBrush="Transparent"/>
                    <Button Content="◉    VPN" HorizontalContentAlignment="Left" Click="ShowVpn_Click" Margin="0,0,0,7" Background="Transparent" BorderBrush="Transparent"/>
                    <Button Content="⚙    Settings" HorizontalContentAlignment="Left" Click="ShowSettings_Click" Background="Transparent" BorderBrush="Transparent"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="VPN STATUS" Foreground="{StaticResource Muted}" FontSize="10" Margin="8,0,0,7"/>
                    <Border Background="#151A22" BorderBrush="#29303D" BorderThickness="1" CornerRadius="10" Padding="12">
                        <StackPanel Orientation="Horizontal"><Ellipse x:Name="VpnDot" Fill="#707782" Width="8" Height="8" Margin="0,0,8,0"/><TextBlock x:Name="VpnStatusText" Text="Disconnected" Foreground="White"/></StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="40,30">
            <Grid x:Name="HomePage">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel><StackPanel><TextBlock Text="Your streaming space" Foreground="White" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Everything you watch, one click away." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,6,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="＋  Add service" Click="AddService_Click" Background="{StaticResource Accent}" BorderBrush="#83EBD2" Foreground="#091410" FontWeight="SemiBold"/></DockPanel>
                <Grid Grid.Row="1" Margin="0,27,0,25"><Border Height="164" CornerRadius="18" BorderBrush="#344152" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#222E42"/><GradientStop Color="#121A25" Offset="0.55"/><GradientStop Color="#163A3B" Offset="1"/></LinearGradientBrush></Border.Background><Grid Margin="28"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="One home for every service." Foreground="White" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Open your favourites in StreamHub or jump straight to their app." Foreground="#B1BBCB" FontSize="13" Margin="0,8,0,17"/><StackPanel Orientation="Horizontal"><Border Background="#295B55" CornerRadius="8" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="● VPN READY" Foreground="#8BF1D8" FontSize="10" FontWeight="Bold"/></Border><Border Background="#263448" CornerRadius="8" Padding="10,5"><TextBlock Text="WEBVIEW2" Foreground="#AFCBF0" FontSize="10" FontWeight="Bold"/></Border></StackPanel></StackPanel><TextBlock Grid.Column="1" Text="▶" FontSize="72" Foreground="#24584F" VerticalAlignment="Center" Margin="40,0,20,0"/></Grid></Border></Grid>
                <DockPanel Grid.Row="2"><StackPanel DockPanel.Dock="Top"><DockPanel Margin="0,0,0,17"><TextBlock Text="Your services" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="285" TextChanged="SearchBox_TextChanged" ToolTip="Search services"/></DockPanel></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="ServiceTiles"/></ScrollViewer></DockPanel>
            </Grid>

            <Grid x:Name="ServicesPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,22"><StackPanel><TextBlock Text="Services" Foreground="White" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Your streaming libraries." Foreground="{StaticResource Muted}"/></StackPanel><Button DockPanel.Dock="Right" Content="＋ Add service" Click="AddService_Click" Background="{StaticResource Accent}" Foreground="#101216"/></DockPanel>
                <ListView x:Name="ServicesList" Grid.Row="1" Background="Transparent" BorderThickness="0">
                    <ListView.ItemTemplate><DataTemplate><Border Background="{StaticResource Panel}" CornerRadius="9" Padding="16" Margin="0,0,0,8"><DockPanel Width="850"><StackPanel><TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Url}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Open" Tag="{Binding}" Click="OpenService_Click"/><Button Content="Delete" Tag="{Binding}" Click="DeleteService_Click" Background="#74343A"/></StackPanel></DockPanel></Border></DataTemplate></ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid x:Name="BrowserPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12"><Button Content="← Home" Click="ShowHome_Click"/><Button Content="←" Click="BrowserBack_Click"/><Button Content="→" Click="BrowserForward_Click"/><Button Content="↻" Click="BrowserRefresh_Click"/><TextBox x:Name="AddressBox" Margin="8,0"/><Button Content="Go" Click="BrowserGo_Click"/><Button Content="Open externally" Click="OpenExternal_Click"/></DockPanel>
                <Border Grid.Row="1" CornerRadius="10" ClipToBounds="True"><wv2:WebView2 x:Name="Browser"/></Border>
            </Grid>

            <Grid x:Name="LiveTvPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,22"><StackPanel><TextBlock Text="Live TV" Foreground="White" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="ChannelCountText" Text="Add an M3U playlist to begin." Foreground="{StaticResource Muted}"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="＋ Add playlist" Click="AddPlaylist_Click" Background="{StaticResource Accent}" Foreground="#091410"/><Button Content="Manage" Click="ManagePlaylists_Click"/></StackPanel></DockPanel>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="#C912161E" BorderBrush="#2B3340" BorderThickness="1" CornerRadius="14" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="ChannelSearchBox" ToolTip="Search channels" TextChanged="ChannelSearch_TextChanged" Margin="0,0,0,10"/><ComboBox x:Name="ChannelGroupBox" Grid.Row="1" SelectionChanged="ChannelGroup_Changed" Margin="0,0,0,10"/><ListView x:Name="ChannelList" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="ChannelList_SelectionChanged" MouseDoubleClick="ChannelList_DoubleClick"><ListView.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,0,0,5" CornerRadius="8" Background="#1B212B"><StackPanel><TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Group}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
                    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="Black" BorderBrush="#2B3340" BorderThickness="1" CornerRadius="14" ClipToBounds="True"><Grid><vlc:VideoView x:Name="IptvVideoView"/><StackPanel x:Name="PlayerPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="▶" Foreground="#344253" FontSize="70" HorizontalAlignment="Center"/><TextBlock Text="Choose a channel to start watching" Foreground="#8591A2" FontSize="14"/></StackPanel></Grid></Border><Border Grid.Row="1" Background="#151A22" BorderBrush="#2B3340" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,12,0,0"><DockPanel><StackPanel><TextBlock x:Name="NowPlayingText" Text="Nothing playing" Foreground="White" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="NowPlayingGroupText" Text="Live TV" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="▶ Play" Click="PlayChannel_Click"/><Button Content="■ Stop" Click="StopChannel_Click"/><Button Content="⛶ Fullscreen" Click="Fullscreen_Click"/></StackPanel></DockPanel></Border></Grid>
                </Grid>
            </Grid>

            <Grid x:Name="VpnPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="VPN" Foreground="White" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Import and control OpenVPN or WireGuard profiles." Foreground="{StaticResource Muted}"/></StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,24,0,18"><Button Content="Import VPN profile" Click="ImportVpn_Click" Background="{StaticResource Accent}" Foreground="#101216"/><Button Content="Disconnect" Click="DisconnectVpn_Click"/><TextBlock x:Name="PublicIpText" Text="Public IP: not checked" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0"/></StackPanel>
                <ListView x:Name="VpnList" Grid.Row="2" Background="Transparent" BorderThickness="0"><ListView.ItemTemplate><DataTemplate><Border Background="{StaticResource Panel}" Padding="16" CornerRadius="8" Margin="0,0,0,8"><DockPanel Width="820"><StackPanel><TextBlock Text="{Binding Name}" Foreground="White" FontSize="16"/><TextBlock Text="{Binding Protocol}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="Connect" Tag="{Binding}" Click="ConnectVpn_Click"/></DockPanel></Border></DataTemplate></ListView.ItemTemplate></ListView>
            </Grid>

            <Grid x:Name="SettingsPage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Width="620" HorizontalAlignment="Left"><TextBlock Text="Settings" Foreground="White" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Application" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,30,0,10"/><TextBlock Text="Dashboard name" Foreground="White"/><TextBox x:Name="DashboardNameBox" Margin="0,7,0,16"/><TextBlock Text="Local server port" Foreground="White"/><TextBox x:Name="PortBox" Margin="0,7,0,22"/>
                    <Border Height="1" Background="#2B3140" Margin="0,4,0,24"/><TextBlock Text="DEVELOPER" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,10"/><CheckBox x:Name="DebugModeBox" Content="Enable debug mode and runtime log" Foreground="White" Margin="0,3,0,20"/><TextBlock Text="REMOTE ACCESS" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,10"/><CheckBox x:Name="RemoteAccessBox" Content="Enable authenticated web dashboard" Foreground="White" Margin="0,3,0,16"/><TextBlock Text="Administrator username" Foreground="White"/><TextBox x:Name="AdminUsernameBox" Margin="0,7,0,16"/><TextBlock Text="New password" Foreground="White"/><PasswordBox x:Name="AdminPasswordBox" Background="#151922" Foreground="White" BorderBrush="#2B3140" Padding="12,9" Margin="0,7,0,7"/><TextBlock Text="Leave blank to keep the existing password. Use at least 12 characters." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,18"/><TextBlock x:Name="ServerStatusText" Text="Server stopped" Foreground="#F1B46A" Margin="0,0,0,18"/>
                    <Button Content="Save and apply settings" HorizontalAlignment="Left" Click="SaveSettings_Click" Background="{StaticResource Accent}" Foreground="#101216"/><TextBlock Text="Designed for Tailscale Serve or Funnel. StreamHub listens only on 127.0.0.1, so it is not directly exposed to the LAN or router." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,24,0,12"/><TextBlock Text="WebView playback depends on each provider's DRM and embedded-browser policies. Use Open externally when required." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,20"/></StackPanel></ScrollViewer>
            </Grid>
        </Grid>

        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Panel.ZIndex="20">
            <Button x:Name="DebugToggleButton" Content="Debug" Click="ToggleDebug_Click" Background="#D9151921" BorderBrush="#343C49" Padding="12,7"/>
            <Button Content="✕" ToolTip="Close StreamHub" Click="CloseApp_Click" Background="#D96C2932" BorderBrush="#98404B" Padding="12,7" FontWeight="Bold"/>
        </StackPanel>

        <Border x:Name="DebugPanel" Grid.Column="1" Width="430" MaxHeight="280" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18" Panel.ZIndex="19" Visibility="Collapsed" Background="#F213171E" BorderBrush="#3B4655" BorderThickness="1" CornerRadius="14" Padding="16">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><StackPanel><TextBlock Text="DEBUG CONSOLE" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="BuildStateText" Text="Release build · Ready" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/><TextBlock x:Name="StreamStatsText" Text="Stream telemetry: idle" Foreground="#7FCDBB" FontFamily="Consolas" FontSize="10" Margin="0,3,0,0"/><TextBlock x:Name="VpnStatsText" Text="VPN telemetry: no active tunnel" Foreground="#82B9E8" FontFamily="Consolas" FontSize="10" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Snapshot" Click="DebugSnapshot_Click" Padding="9,5"/><Button Content="Export" Click="ExportDebug_Click" Padding="9,5"/><Button Content="Clear" Click="ClearDebug_Click" Padding="9,5"/></StackPanel></DockPanel><TextBox x:Name="DebugLogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="#0C0F14"/></Grid>
        </Border>
    </Grid>
</Window>
